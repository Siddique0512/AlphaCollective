# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TESSERA_API_KEY: API Key for Tessera API (https://tesserapp.org/docs/develop)
# Used by the backend server to fetch live and ended Alpha Collectiv3 Discord raffles.
TESSERA_API_KEY="YOUR_TESSERA_API_KEY"

# TESSERA_WEBHOOK_SECRET: Optional HMAC-SHA256 secret for verifying incoming Tessera live event webhooks.
TESSERA_WEBHOOK_SECRET="YOUR_TESSERA_WEBHOOK_SECRET"

# DISCORD_BOT_TOKEN: Optional bot token to fetch messages directly from Alpha Collectiv3 Discord channels.
DISCORD_BOT_TOKEN="YOUR_DISCORD_BOT_TOKEN"

# DISCORD_AIRDROP_CHANNEL_ID: Discord Channel ID for the #airdrop channel.
DISCORD_AIRDROP_CHANNEL_ID="1557705831812964393"

# DISCORD_AIRDROP_WEBHOOK_URL: Discord Webhook URL for the Airdrop channel.
DISCORD_AIRDROP_WEBHOOK_URL="https://discord.com/api/webhooks/1559546892252352592/kOJuuMgNYiEsMfnjFXvEt70NEb2rR2-CEp34hewUkdHrc74YH0NfXyn-BIn_AyUDSAYB"

# DISCORD_TRENDS_CHANNEL_ID: Discord Channel ID for Trends & Market Intel (e.g. 1555848318960013342).
DISCORD_TRENDS_CHANNEL_ID="1555848318960013342"

# DISCORD_TRENDS_WEBHOOK_URL: Discord Webhook URL for the Trends channel.
DISCORD_TRENDS_WEBHOOK_URL="https://discord.com/api/webhooks/1559576791503343717/9GACy32EApMOlGboE0QKdXTJN-gqO0c3OHcPjBxTb2gHL0UEmV-wqB0PYPKDWKOqEXee"

# DISCORD_APPLICATIONS_CHANNEL_ID: Discord Channel ID for the #invite-applications channel (1559546521861619802).
DISCORD_APPLICATIONS_CHANNEL_ID="1559546521861619802"

# DISCORD_APPLICATIONS_WEBHOOK_URL: Discord Webhook URL for #invite-applications channel.
DISCORD_APPLICATIONS_WEBHOOK_URL="https://discord.com/api/webhooks/1559546595899342938/ghji0QZHJvqQ7FGxHc0V4MuaV0Ub73T9PPD3ApeIQzXuVCaBaOuck75BxUKrbjrhzG2k"

# VERCEL CLIENT-SIDE DIRECT DISPATCH ENVIRONMENT VARIABLES:
